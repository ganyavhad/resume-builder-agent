{
  "name": "resume-generator",
  "displayName": "Resume Generator",
  "description": "Generate professional resumes in HTML/CSS with PDF export",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:resume-generator.openResumeBuilder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "resume-generator.openResumeBuilder",
        "title": "Open Resume Builder"
      }
    ],
    "viewsContainers": {
      "sidebar": [
        {
          "id": "resume-generator-sidebar",
          "title": "Resume Builder",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "resume-generator-sidebar": [
        {
          "id": "resume-generator-view",
          "name": "Resume Builder",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:extension -- --minify && npm run build:server -- --minify",
    "build:extension": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --target=node16",
    "build:server": "esbuild ./src/server.ts --bundle --outfile=dist/server.js --platform=node --target=node16",
    "esbuild-base": "npm run build:extension && npm run build:server",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "concurrently \"npm run build:extension -- --sourcemap --watch\" \"npm run build:server -- --sourcemap --watch\"",
    "typecheck": "tsc --noEmit",
    "server": "node dist/server.js",
    "dev": "concurrently \"npm run esbuild-watch\" \"npm run server\"",
    "postinstall": "npm run typecheck"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.110.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/test-web": "^0.0.50",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "puppeteer": "^21.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
