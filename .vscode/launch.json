{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "preLaunchTask": "npm: esbuild-watch"
        },
        {
            "name": "Backend Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/server.js",
            "restart": true,
            "console": "integratedTerminal",
            "preLaunchTask": "npm: esbuild"
        }
    ]
}